    }
}

// ===== CHỌN FILE =====
- (void)openFilePicker {
    if (@available(iOS 14.0, *)) {
        UIDocumentPickerViewController *p = [[UIDocumentPickerViewController alloc]
            initForOpeningContentTypes:@[UTTypeData, UTTypeItem] asCopy:YES];
        p.delegate = self;
        p.allowsMultipleSelection = NO;
        [self presentViewController:p animated:YES completion:nil];
    } else {
        UIDocumentPickerViewController *p = [[UIDocumentPickerViewController alloc]
            initWithDocumentTypes:@[@"public.data"] inMode:UIDocumentPickerModeImport];
        p.delegate = self;
        [self presentViewController:p animated:YES completion:nil];
    }
}

- (void)documentPicker:(UIDocumentPickerViewController *)c didPickDocumentsAtURLs:(NSArray<NSURL *> *)urls {
    if (!urls.count) return;
    NSURL *src = urls.firstObject;
    NSString *name = src.lastPathComponent;
    if (![name containsString:@"assetindexer"]) {
        [self showStatus:@"⚠️ File không đúng định dạng!" color:kRed];
        return;
    }
    [[NSFileManager defaultManager] createDirectoryAtPath:kWorkDir withIntermediateDirectories:YES attributes:nil error:nil];
    NSString *dest = [kWorkDir stringByAppendingPathComponent:kTargetFile];
    [[NSFileManager defaultManager] removeItemAtPath:dest error:nil];
    NSError *e = nil;
    if (![[NSFileManager defaultManager] copyItemAtURL:src toURL:[NSURL fileURLWithPath:dest] error:&e]) {
        [self showStatus:[NSString stringWithFormat:@"Lỗi: %@", e.localizedDescription] color:kRed];
        return;
    }
    gLoadedFile = dest;
    [self updateFileLbl];
    [self showStatus:@"✓ Đã nạp file thành công" color:kGreen];
}

- (void)documentPickerWasCancelled:(UIDocumentPickerViewController *)c {
    [self showStatus:@"Đã hủy chọn file" color:kTextDim];
}

// ===== LỌC =====
- (void)applyFilter:(NSString*)q {
    self.filtered = [NSMutableArray array];
    self.filteredIdx = [NSMutableArray array];
    NSString *lower = [q lowercaseString];
    for (int i = 0; i < kBoneList.count; i++) {
        NSString *n = kBoneList[i];
        if (!lower.length || [[n lowercaseString] containsString:lower]) {
            [self.filtered addObject:n];
            [self.filteredIdx addObject:@(i)];
        }
    }
    [self.boneTable reloadData];
    // Cập nhật chiều cao table
    CGFloat h = self.filtered.count * 62;
    CGRect f = self.boneTable.frame;
    f.size.height = h;
    self.boneTable.frame = f;
    self.mainScroll.contentSize = CGSizeMake(self.view.bounds.size.width, f.origin.y + h + 60);
}

// ===== TABLE =====
- (NSInteger)tableView:(UITableView *)tv numberOfRowsInSection:(NSInteger)s { return self.filtered.count; }
- (UITableViewCell *)tableView:(UITableView *)tv cellForRowAtIndexPath:(NSIndexPath *)ip {
    NSMODBoneRow *c = [tv dequeueReusableCellWithIdentifier:@"bone" forIndexPath:ip];
    int realIdx = [self.filteredIdx[ip.row] intValue];
    c.boneIdx = realIdx;
    [c.editBtn removeTarget:nil action:nil forControlEvents:UIControlEventAllEvents];
    [c.editBtn addTarget:self action:@selector(editBone:) forControlEvents:UIControlEventTouchUpInside];
    return c;
}

- (void)editBone:(UIButton*)b {
    // Tìm cell cha
    UITableViewCell *cell = (UITableViewCell*)b.superview;
    while (cell && ![cell isKindOfClass:[NSMODBoneRow class]]) cell = (UITableViewCell*)cell.superview;
    if (!cell) return;
    NSMODBoneRow *row = (NSMODBoneRow*)cell;
    
    NSMODBoneDetail *d = [[NSMODBoneDetail alloc] init];
    d.boneIdx = row.boneIdx;
    [self.navigationController pushViewController:d animated:YES];
}

- (void)searchBar:(UISearchBar *)sb textDidChange:(NSString *)t { [self applyFilter:t]; }
- (void)searchBarSearchButtonClicked:(UISearchBar *)sb { [sb resignFirstResponder]; }

// ===== HÀNH ĐỘNG =====
- (void)toggleMaster:(UISwitch*)s {
    gCfg[@"enable"] = @(s.isOn);
    [self showStatus:s.isOn ? @"Đã BẬT" : @"Đã TẮT" color:kGreen];
}
- (void)globalChanged:(UISlider*)s {
    gCfg[@"globalScale"] = @(s.value);
    self.globalValLbl.text = [NSString stringWithFormat:@"%.2f", s.value];
}
- (void)saveConfig {
    [gCfg writeToFile:kCfgPath atomically:YES];
    [self showStatus:@"✓ Đã lưu cấu hình" color:kGreen];
}
- (void)showStatus:(NSString*)msg color:(UIColor*)c {
    self.statusLbl.text = msg;
    self.statusLbl.textColor = c;
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 3*NSEC_PER_SEC), dispatch_get_main_queue(), ^{
        self.statusLbl.text = @"MADE BY NSMOD";
        self.statusLbl.textColor = kTextDim;
    });
}
- (void)viewWillAppear:(BOOL)animated {
    [super viewWillAppear:animated];
    [self.boneTable reloadData];
}
- (void)dismiss { [self dismissViewControllerAnimated:YES completion:nil]; }
@end

