static NSMutableDictionary *boneCfg(int idx) {
    NSString *k = [NSString stringWithFormat:@"b%d", idx];
    NSMutableDictionary *d = gCfg[k];
    if (!d) {
        d = [@{@"sx":@1.0,@"sy":@1.0,@"sz":@1.0,
               @"ox":@0.0,@"oy":@0.0,@"oz":@0.0,
               @"rx":@0.0,@"ry":@0.0,@"rz":@0.0,
               @"swapX":@(-1),@"swapY":@(-1),@"swapZ":@(-1)} mutableCopy];
        gCfg[k] = d;
    }
    return d;
}

