- (void)addSliderTo:(UIView*)parent y:(CGFloat)y key:(NSString*)key label:(NSString*)label color:(UIColor*)color value:(float)v {
    CGFloat W = parent.frame.size.width;
    
    UILabel *l = [[UILabel alloc] initWithFrame:CGRectMake(14, y, 30, 20)];
    l.text = label;
    l.textColor = color;
    l.font = [UIFont boldSystemFontOfSize:14];
    [parent addSubview:l];
    
    UILabel *val = [[UILabel alloc] initWithFrame:CGRectMake(W-80, y, 66, 20)];
    val.text = [NSString stringWithFormat:@"%.2f", v];
    val.textColor = color;
    val.font = [UIFont fontWithName:@"Menlo-Bold" size:12] ?: [UIFont boldSystemFontOfSize:12];
    val.textAlignment = NSTextAlignmentRight;
    val.tag = [self tagForKey:key];
    [parent addSubview:val];
    
    UISlider *s = [[UISlider alloc] initWithFrame:CGRectMake(50, y, W-140, 24)];
    BOOL isRotate = [key hasPrefix:@"r"];
    BOOL isOffset = [key hasPrefix:@"o"];
    if (isRotate) {
        s.minimumValue = -180.0f; s.maximumValue = 180.0f;
    } else if (isOffset) {
        s.minimumValue = -2.0f; s.maximumValue = 2.0f;
    } else {
        s.minimumValue = 0.1f; s.maximumValue = 5.0f;
    }
    s.value = v;
    s.minimumTrackTintColor = color;
    s.maximumTrackTintColor = [UIColor colorWithWhite:0.15 alpha:1];
    s.thumbTintColor = color;
    s.tag = [self sliderTagForKey:key];
    [s addTarget:self action:@selector(sliderChanged:) forControlEvents:UIControlEventValueChanged];
    [parent addSubview:s];
}

- (int)tagForKey:(NSString*)k {
    if ([k isEqual:@"sx"]) return 1001;
    if ([k isEqual:@"sy"]) return 1002;
    if ([k isEqual:@"sz"]) return 1003;
    if ([k isEqual:@"ox"]) return 1004;
    if ([k isEqual:@"oy"]) return 1005;
    if ([k isEqual:@"oz"]) return 1006;
    if ([k isEqual:@"rx"]) return 1007;
    if ([k isEqual:@"ry"]) return 1008;
    if ([k isEqual:@"rz"]) return 1009;
    return 0;
}
- (int)sliderTagForKey:(NSString*)k {
    return [self tagForKey:k] - 1000;
}
- (NSString*)keyForSliderTag:(int)t {
    NSArray *keys = @[@"sx",@"sy",@"sz",@"ox",@"oy",@"oz",@"rx",@"ry",@"rz"];
    if (t < 0 || t >= keys.count) return @"";
    return keys[t];
}

- (void)sliderChanged:(UISlider*)s {
    NSString *key = [self keyForSliderTag:(int)s.tag];
    if (key.length == 0) return;
    NSMutableDictionary *c = boneCfg(self.boneIdx);
    c[key] = @(s.value);
    UILabel *val = [self.view viewWithTag:[self tagForKey:key]];
    if (!val) {
        for (UIView *v in self.scroll.subviews) {
            UIView *found = [v viewWithTag:[self tagForKey:key]];
            if (found) { val = (UILabel*)found; break; }
        }
    }
    val.text = [NSString stringWithFormat:@"%.2f", s.value];
}

- (void)pickSwapBone:(UIButton*)b {
    int axis = (int)b.tag - 5000;
    UIAlertController *ac = [UIAlertController alertControllerWithTitle:@"Chọn xương để hoán đổi"
        message:nil preferredStyle:UIAlertControllerStyleActionSheet];
    NSMutableDictionary *c = boneCfg(self.boneIdx);
    [ac addAction:[UIAlertAction actionWithTitle:@"❌ BỎ HOÁN ĐỔI" style:UIAlertActionStyleDestructive handler:^(UIAlertAction *a){
        c[axis==0?@"swapX":(axis==1?@"swapY":@"swapZ")] = @(-1);
        [self reloadButtons];
    }]];
    for (int i = 0; i < kBoneList.count; i++) {
        if (i == self.boneIdx) continue;
        NSString *t = kBoneList[i];
        [ac addAction:[UIAlertAction actionWithTitle:t style:UIAlertActionStyleDefault handler:^(UIAlertAction *a){
            c[axis==0?@"swapX":(axis==1?@"swapY":@"swapZ")] = @(i);
            [self reloadButtons];
        }]];
    }
    ac.popoverPresentationController.sourceView = b;
    ac.popoverPresentationController.sourceRect = b.bounds;
    [self presentViewController:ac animated:YES completion:nil];
}

- (void)reloadButtons {
    NSMutableDictionary *c = boneCfg(self.boneIdx);
    NSArray *keys = @[@"swapX", @"swapY", @"swapZ"];
    CGFloat W = self.view.bounds.size.width;
    for (int i = 0; i < 3; i++) {
        UIButton *b = [self.view viewWithTag:5000 + i];
        if (!b) {
            for (UIView *v in self.scroll.subviews) {
                UIView *f = [v viewWithTag:5000 + i];
                if (f) { b = (UIButton*)f; break; }
            }
        }
        if (!b) continue;
        int swapIdx = [c[keys[i]] intValue];
        NSString *bTitle = swapIdx < 0 ? @"▸ CHỌN XƯƠNG ĐỂ HOÁN ĐỔI" :
                           [NSString stringWithFormat:@"⇄ %@", kBoneList[swapIdx]];
        [b setTitle:bTitle forState:UIControlStateNormal];
        [b setTitleColor:swapIdx < 0 ? kTextDim : kOrange forState:UIControlStateNormal];
        b.layer.borderColor = swapIdx < 0 ? kCardBorder.CGColor : kOrange.CGColor;
    }
}

- (void)resetThis {
    gCfg[[NSString stringWithFormat:@"b%d", self.boneIdx]] =
        [@{@"sx":@1.0,@"sy":@1.0,@"sz":@1.0,
           @"ox":@0.0,@"oy":@0.0,@"oz":@0.0,
           @"rx":@0.0,@"ry":@0.0,@"rz":@0.0,
           @"swapX":@(-1),@"swapY":@(-1),@"swapZ":@(-1)} mutableCopy];
    [self dismissViewControllerAnimated:YES completion:nil];
}
@end

